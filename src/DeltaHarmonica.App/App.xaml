<Application x:Class="DeltaHarmonica.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="AccentBrush" Color="#63E6BE" />
   <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="#202B32" /><Setter Property="BorderBrush" Value="#35414B" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="22" /></Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
   <Style x:Key="CaptionStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#AEBCC6" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="13" /></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
