<Window x:Class="DeltaHarmonica.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="using:DeltaHarmonica.App.Models"
 xmlns:controls="using:DeltaHarmonica.App.Controls" Title="三角洲口琴 · Delta Harmonica">
 <Grid x:Name="RootGrid" Background="#141D24" RequestedTheme="Dark" Padding="28" RowSpacing="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="16"><Image Source="ms-appx:///Assets/logo.png" Width="82" Height="82" Stretch="Uniform" AutomationProperties.Name="三角洲口琴 logo"/><StackPanel Spacing="5"><TextBlock Text="DELTA / HARMONICA" FontSize="12" CharacterSpacing="250" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="三角洲口琴自动演奏工具" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="MIDI 演奏工作台 · 音频转录 · 全局快捷键" Style="{StaticResource CaptionStyle}"/><TextBlock Text="开源免费项目，严禁倒卖盈利" Foreground="{StaticResource AccentBrush}" FontSize="13"/></StackPanel></StackPanel>
   <Border Grid.Column="1" Background="#253D37" CornerRadius="20" Padding="16,8" VerticalAlignment="Center"><TextBlock x:Name="StateBadge" Text="● 就绪" Foreground="{StaticResource AccentBrush}"/></Border>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}">
    <Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Spacing="5"><TextBlock Text="我的曲库" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="LibraryCount" Text="导入 MIDI，开始第一段旋律" Style="{StaticResource CaptionStyle}"/></StackPanel>
     <StackPanel Grid.Row="1" Spacing="8"><Button Content="＋ 导入 MIDI" Click="ImportMidi_Click" HorizontalAlignment="Stretch"/><Button Content="载入小星星示例" Click="LoadDemo_Click" HorizontalAlignment="Stretch"/></StackPanel>
     <ListView Grid.Row="2" x:Name="PlaylistList" SelectionChanged="PlaylistList_SelectionChanged" Background="Transparent" HorizontalContentAlignment="Stretch">
      <ListView.ItemTemplate><DataTemplate x:DataType="models:SongEntry"><StackPanel Padding="2,10" Spacing="5"><TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="#AEBCC6"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <StackPanel Grid.Row="3" Spacing="12"><Button Content="移除所选曲目" Click="RemoveSong_Click" HorizontalAlignment="Stretch"/><TextBlock Text="先打开游戏内口琴，再开始演奏。倒计时结束时锁定前台窗口。" Style="{StaticResource CaptionStyle}"/></StackPanel>
    </Grid>
   </Border>
   <Pivot Grid.Column="1" x:Name="WorkspacePivot" Margin="0,-12,0,0" SelectionChanged="WorkspacePivot_SelectionChanged">
    <PivotItem Header="演奏">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18" Padding="0,12,6,8">
       <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16">
        <TextBlock Text="NOW PLAYING" FontSize="11" CharacterSpacing="160" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock x:Name="SongTitle" Text="选择一首 MIDI" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SongInfo" Text="支持 .mid / .midi、多音轨和 MIDI 变速事件" Style="{StaticResource CaptionStyle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="演奏区间" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="ResetRangeButton" Content="恢复整首" Click="ResetRange_Click" IsEnabled="False"/></Grid>
        <controls:PlaybackTimeline x:Name="TimelineSlider" RangeChanged="PlaybackRange_ValueChanged" PositionChanged="TimelineSlider_ValueChanged" IsEnabled="False"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionLabel" Text="00:00 / 00:00" Foreground="#AEBCC6"/><TextBlock Grid.Column="1" x:Name="SpeedLabel" Text="1.00 ×" Foreground="{StaticResource AccentBrush}"/></Grid>
        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="RangeStartLabel" Text="开始位置 · 00:00.000"/><TextBlock Grid.Column="1" x:Name="RangeEndLabel" Text="结束位置 · 00:00.000" HorizontalAlignment="Right"/></Grid>
        <TextBlock x:Name="RangeSummary" Text="拖动进度条上方的“起 / 止”选择区间，白色标记显示播放位置。预览与演奏均使用此区间。" Style="{StaticResource CaptionStyle}"/>
        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="上一首" Click="Previous_Click"/><Button x:Name="PlayButton" Content="▶ 开始演奏" Click="Play_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="暂停 / 继续" Click="Pause_Click"/><Button Content="停止" Click="Stop_Click"/><Button Content="下一首" Click="Next_Click"/></StackPanel>
        <TextBlock x:Name="PlaybackHotkeyHint" Text="全局快捷键 · F5 开始演奏，F8 暂停 / 继续，F6 上一首，F7 下一首，F9 停止" Style="{StaticResource CaptionStyle}"/>
        <StackPanel Orientation="Horizontal" Spacing="18"><Button Content="预览按键" Click="Preview_Click" ToolTipService.ToolTip="使用内置口琴音效试听当前指法，无需打开游戏。"/><CheckBox x:Name="AutoNextCheck" Content="播完自动下一首" Checked="Preference_Changed" Unchecked="Preference_Changed" VerticalAlignment="Center"/></StackPanel>
        <TextBlock x:Name="TargetLabel" Text="目标窗口：开始演奏后锁定" Style="{StaticResource CaptionStyle}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14">
        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="TrackCombo" Header="演奏音轨" HorizontalAlignment="Stretch" SelectionChanged="Mapping_Changed"/><ComboBox Grid.Column="1" x:Name="ChordCombo" Header="旋律 / 和弦" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Mapping_Changed"><ComboBoxItem Content="最高音 · 适合主旋律"/><ComboBoxItem Content="最低音 · 适合低音旋律"/><ComboBoxItem Content="兼容和弦 · 共享鼠标变调"/></ComboBox></Grid>
        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="演奏倍速"/><Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="3" Value="1" StepFrequency="0.05" ValueChanged="SpeedSlider_ValueChanged"/></StackPanel><NumberBox Grid.Column="1" x:Name="TransposeBox" Header="整体移调 / 半音" Minimum="-36" Maximum="36" Value="0" SpinButtonPlacementMode="Compact" ValueChanged="MappingNumber_Changed"/></Grid>
        <TextBlock x:Name="PlanInfo" Text="预览同步播放内置口琴音效，不向游戏发送输入。" Style="{StaticResource CaptionStyle}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="口琴指法" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="1" x:Name="ModifierLabel" Text="原调" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></Grid><Grid x:Name="KeyboardGrid" ColumnSpacing="8" Height="76"/><TextBlock Text="按住左键：低八度    按住右键：高八度    按住中键：升半音" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </PivotItem>
    <PivotItem Header="音频转 MIDI"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18" Padding="0,12,6,8">
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14">
      <TextBlock Text="从声音中提取旋律" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="使用本地 Basic Pitch 模型转录，并清理短音、碎片和重叠音符。优先使用干净的单乐器、独奏音频；完整混音和含人声歌曲通常不适合直接提取，需要后期整理。" Style="{StaticResource CaptionStyle}"/>
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AudioPathBox" Header="音频文件" IsReadOnly="True" PlaceholderText="WAV / MP3 / FLAC / OGG / M4A"/><Button Grid.Column="1" Content="选择音频" Click="SelectAudio_Click" VerticalAlignment="Bottom"/></Grid>
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputDirectoryBox" Header="MIDI 保存目录"/><Button Grid.Column="1" Content="选择目录" Click="SelectOutput_Click" VerticalAlignment="Bottom"/></Grid>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="AudioPresetCombo" Header="音符清理" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="AudioPreference_Changed">
        <ComboBoxItem Content="独奏 / 单声部 · 最短约 60ms" Tag="solo"/>
        <ComboBoxItem Content="标准 / 推荐 · 最短约 140ms" Tag="balanced"/>
        <ComboBoxItem Content="长音优先 · 最短约 200ms" Tag="ensemble"/>
       </ComboBox>
       <ComboBox Grid.Column="1" x:Name="AudioMelodyCombo" Header="输出旋律" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="AudioPreference_Changed">
        <ComboBoxItem Content="原版 · 最高音，保留起音" Tag="highest"/>
        <ComboBoxItem Content="精简 · 跟随一条旋律" Tag="smart"/>
        <ComboBoxItem Content="多音 · 保留清理后的和弦" Tag="polyphonic"/>
       </ComboBox>
      </Grid>
      <TextBlock Text="标准清理适合多数乐器录音；独奏模式保留较短的音符，长音优先过滤更多碎音。原版选取同时发声的最高音并保留起音；精简模式减少重叠，跟随一条旋律。" Style="{StaticResource CaptionStyle}"/>
      <ComboBox x:Name="AudioQuantizationCombo" Header="节拍量化" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="AudioPreference_Changed">
       <ComboBoxItem Content="不量化 · 保留原始时值" Tag="none"/>
       <ComboBoxItem Content="1/4 拍" Tag="1/4"/>
       <ComboBoxItem Content="1/8 拍" Tag="1/8"/>
       <ComboBoxItem Content="1/16 拍" Tag="1/16"/>
      </ComboBox>
      <TextBlock Text="自动估算 BPM 和拍点；失败时使用 120 BPM。量化将音符起点和终点对齐到所选拍长。" Style="{StaticResource CaptionStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="TranscribeButton" Content="开始转录并加入曲库" Style="{StaticResource AccentButtonStyle}" Click="Transcribe_Click"/><Button x:Name="CancelAudioButton" Content="取消" IsEnabled="False" Click="CancelAudio_Click"/></StackPanel>
      <ProgressBar x:Name="AudioProgress" IsIndeterminate="False" Value="0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="转录环境" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="EnvironmentLabel" Text="需要首次安装转录依赖" Style="{StaticResource CaptionStyle}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PythonPathBox" Header="Python 3.10–3.12（64 位）" PlaceholderText="选择 python.exe 的完整路径"/><Button Grid.Column="1" Content="选择 Python" Click="SelectPython_Click" VerticalAlignment="Bottom"/></Grid><Button x:Name="InstallAudioButton" Content="安装本地转录环境" Click="InstallAudio_Click"/><TextBlock Text="仅首次安装需要网络。依赖保存在应用数据目录的独立环境中。" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="任务日志" Style="{StaticResource SectionTitle}"/><TextBox x:Name="AudioLogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="300" FontFamily="Cascadia Mono" FontSize="12" Loaded="AudioLogBox_Loaded" TextChanged="AudioLogBox_TextChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
    </StackPanel></ScrollViewer></PivotItem>
    <PivotItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18" Padding="0,12,6,8">
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="全局快捷键" Style="{StaticResource SectionTitle}"/><TextBlock Text="在游戏前台也可使用。填写 F5、Ctrl+Alt+P 等组合，保存后生效。松开开始快捷键后进入倒计时；演奏中重复按开始键不会重启曲目。" Style="{StaticResource CaptionStyle}"/><Grid ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBox x:Name="StartHotkeyBox" Header="开始演奏" Text="F5"/><TextBox Grid.Column="1" x:Name="PauseHotkeyBox" Header="暂停 / 继续" Text="F8"/><TextBox Grid.Row="1" x:Name="PreviousHotkeyBox" Header="上一首" Text="F6"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="NextHotkeyBox" Header="下一首" Text="F7"/><TextBox Grid.Row="2" x:Name="StopHotkeyBox" Header="停止" Text="F9"/></Grid><Button Content="保存快捷键" Click="SaveHotkeys_Click"/><TextBlock x:Name="HotkeyStatus" Style="{StaticResource CaptionStyle}"/></StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="音高校准" Style="{StaticResource SectionTitle}"/><TextBlock Text="默认 Z = C4（MIDI 60），八个键对应 C D E F G A B C。可按游戏实际音高调整；MIDI 60 的八度名称可能因软件而异。" Style="{StaticResource CaptionStyle}"/><Grid ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><NumberBox x:Name="BaseNoteBox" Header="Z 基准 MIDI 音高" Minimum="0" Maximum="115" Value="60" SpinButtonPlacementMode="Compact" ValueChanged="MappingNumber_Changed"/><NumberBox Grid.Column="1" x:Name="SemitoneBox" Header="中键偏移 / 半音" Minimum="-2" Maximum="2" Value="1" SpinButtonPlacementMode="Compact" ValueChanged="MappingNumber_Changed"/><NumberBox Grid.Row="1" x:Name="LowerOffsetBox" Header="左键偏移 / 半音" Minimum="-36" Maximum="0" Value="-12" SpinButtonPlacementMode="Compact" ValueChanged="MappingNumber_Changed"/><NumberBox Grid.Row="1" Grid.Column="1" x:Name="UpperOffsetBox" Header="右键偏移 / 半音" Minimum="0" Maximum="36" Value="12" SpinButtonPlacementMode="Compact" ValueChanged="MappingNumber_Changed"/></Grid><CheckBox x:Name="FoldOctavesCheck" Content="超出音域时折叠八度（关闭则跳过）" IsChecked="True" Checked="MappingCheck_Changed" Unchecked="MappingCheck_Changed"/><NumberBox x:Name="CountdownBox" Header="开始演奏倒计时 / 秒" Minimum="2" Maximum="15" Value="5" SpinButtonPlacementMode="Compact" ValueChanged="PreferenceNumber_Changed"/></StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="演奏方式" Style="{StaticResource SectionTitle}"/><TextBlock Text="系统通过标准 Windows SendInput 模拟按键。暂停、停止、切歌、窗口失焦时释放键盘和鼠标；再次开始需切回原目标窗口。游戏是否接受模拟输入，需要在游戏内实际验证。" Style="{StaticResource CaptionStyle}"/><Button Content="打开应用数据目录" Click="OpenData_Click"/></StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="项目声明与风险提示" Style="{StaticResource SectionTitle}"/><TextBlock Text="开源免费项目，严禁倒卖盈利" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/><TextBlock Text="风险提示：本软件通过模拟键盘和鼠标输入演奏。使用自动化工具可能违反游戏规则或服务条款，并导致账号限制、封禁等处罚。使用前请自行了解并遵守游戏规则；管理员权限不代表游戏允许使用本软件。请只导入和转录你有权使用的 MIDI、音频及其他素材。" Style="{StaticResource CaptionStyle}"/><TextBlock Text="免责声明：本软件按现状提供，仅供学习交流。作者不保证游戏兼容性、演奏效果或转录准确性。使用者自行决定是否使用，并承担由此产生的账号处罚、数据损失及其他风险；在适用法律允许的范围内，作者不对相关损失承担责任。" Style="{StaticResource CaptionStyle}"/><HyperlinkButton Content="开源地址 · github.com/Amor-Vooc/DeltaHarmonica" NavigateUri="https://github.com/Amor-Vooc/DeltaHarmonica" Padding="0,6" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel></ScrollViewer></PivotItem>
   </Pivot>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="6"><InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Message="准备就绪。导入 MIDI 后可先预览按键。"/><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="风险提示：模拟输入可能导致游戏账号处罚，请自行评估。完整免责声明见“设置”。" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><HyperlinkButton Grid.Column="1" Content="开源地址 ↗" NavigateUri="https://github.com/Amor-Vooc/DeltaHarmonica" Padding="0,4"/></Grid></StackPanel>
 </Grid>
</Window>
