<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/DeltaHarmonica.Core/DeltaHarmonica.Core.csproj" />
    <Compile Include="../../../../src/DeltaHarmonica.App/Services/AudioTranscriptionService.cs" Link="AudioTranscriptionService.cs" />
    <Content Include="../../audio_to_midi.py" Link="tools/audio_to_midi/audio_to_midi.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../requirements.txt" Link="tools/audio_to_midi/requirements.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/*" Link="tools/audio_to_midi/vendor/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
